# Copy to .env and fill in. Never commit .env.

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Required when running the backend without Docker.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/nexhire
# Optional direct (non-pooled) connection used only by migrations.
DIRECT_URL=

# Without a key the app still runs: questions come from the curated bank, but answers cannot be scored.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional tuning (defaults shown).
# ACCESS_TOKEN_MINUTES=60
# MAX_QUESTIONS=5
# GEMINI_RPM=15
# AI_USER_RPM=10
# LOGIN_RPM=10
